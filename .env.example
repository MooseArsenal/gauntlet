# Gauntlet configuration — copy to .env. Every value has a safe default except
# the two marked REQUIRED. Booleans accept 1/0.

# ---- required in any real deployment --------------------------------------
GAUNTLET_SECRET_KEY=            # REQUIRED: 32+ random bytes, e.g. `openssl rand -hex 32`. Signs auth tokens.
POSTGRES_PASSWORD=              # REQUIRED with docker-compose: the database password.

# ---- runtime --------------------------------------------------------------
GAUNTLET_ENV=production         # production enables HSTS and refuses insecure defaults at startup
GAUNTLET_PORT=8000
GAUNTLET_DB_URL=                # set by docker-compose; otherwise sqlite:///./gauntlet.db or postgresql+psycopg://…
GAUNTLET_SEED=0                 # 1 loads the worked demo (and its demo account) on an empty database
GAUNTLET_DEMO_PASSWORD=         # password for the demo admin when GAUNTLET_SEED=1
GAUNTLET_TRUST_PROXY=1          # honour X-Forwarded-For (only behind a proxy that sets it)
GAUNTLET_CORS_ORIGINS=          # comma-separated allowed origins (empty = same-origin only)
GAUNTLET_AIRGAPPED=0            # 1 refuses every outbound connection (SSO, LLM, trackers, ranges, webhooks)

# ---- keys -----------------------------------------------------------------
GAUNTLET_TIMELINE_KEY=          # optional separate key for the tamper-evident timeline (defaults to a derivation of SECRET_KEY)
# Signs exercise certificates (M1); derived from the secret key when unset.
#GAUNTLET_CERTIFICATE_KEY=
GAUNTLET_ENCRYPT_AT_REST=0      # 1 seals sensitive environment fields; keys derive from SECRET_KEY unless DATA_KEYS is set
GAUNTLET_DATA_KEYS=             # rotatable keyring: v2:<base64>,v1:<base64> (primary first)

# ---- identity -------------------------------------------------------------
GAUNTLET_ACCESS_TTL_MIN=30
GAUNTLET_REFRESH_TTL_DAYS=30
GAUNTLET_PASSWORD_MIN_LEN=10
GAUNTLET_MFA_ISSUER=Gauntlet
GAUNTLET_LOGIN_MAX_ATTEMPTS=5           # per source address
GAUNTLET_LOGIN_ACCOUNT_MAX_ATTEMPTS=20  # per account, any address
GAUNTLET_LOGIN_WINDOW_SEC=300
GAUNTLET_LOGIN_LOCKOUT_SEC=900
GAUNTLET_OIDC_ISSUER=           # SSO is enabled when issuer + client id are set
GAUNTLET_OIDC_CLIENT_ID=
GAUNTLET_OIDC_CLIENT_SECRET=
GAUNTLET_OIDC_REDIRECT_URI=     # https://<host>/api/auth/oidc/callback

# ---- limits & retention ---------------------------------------------------
GAUNTLET_MAX_REQUEST_BYTES=4194304
GAUNTLET_MAX_YAML_BYTES=262144
GAUNTLET_MAX_IMPORT_BYTES=2097152
GAUNTLET_MAX_INJECTS=1000
GAUNTLET_RETENTION_DAYS=0       # 0 = keep everything; otherwise completed sessions + audit rows older than this are purged on request
GAUNTLET_SECONDS_PER_MIN=3      # real-time mode: wall seconds per game minute

# ---- integrations (all optional) -----------------------------------------
GAUNTLET_NOTIFY_WEBHOOK=
GAUNTLET_JIRA_URL=
GAUNTLET_JIRA_USER=
GAUNTLET_JIRA_TOKEN=
GAUNTLET_JIRA_PROJECT=
GAUNTLET_SERVICENOW_URL=
GAUNTLET_SERVICENOW_USER=
GAUNTLET_SERVICENOW_PASSWORD=
GAUNTLET_RANGE_ADAPTER=simulation   # simulation | caldera | atomic
GAUNTLET_RANGE_ALLOWLIST=
GAUNTLET_CALDERA_URL=
GAUNTLET_CALDERA_API_KEY=
GAUNTLET_ATOMIC_URL=
GAUNTLET_ATOMIC_TOKEN=
GAUNTLET_LLM_PROVIDER=
GAUNTLET_LLM_API_KEY=
GAUNTLET_LLM_MODEL=
GAUNTLET_LLM_BASE_URL=
GAUNTLET_BRAND_NAME=Gauntlet
GAUNTLET_BRAND_ACCENT=217,72,15

# Enterprise (M5)
#GAUNTLET_REDIS_URL=redis://redis:6379/0   # shared throttle store; unset = in-process memory
#GAUNTLET_RLS_ENABLED=1                     # Postgres row-level security; default on in production

# Inject delivery and invitations (P2) — all optional; unset channels report "not configured"
#GAUNTLET_SMTP_HOST=smtp.example.com
#GAUNTLET_SMTP_PORT=587
#GAUNTLET_SMTP_USER=
#GAUNTLET_SMTP_PASSWORD=
#GAUNTLET_SMTP_FROM=noreply@moosearsenal.com
#GAUNTLET_SMTP_STARTTLS=1
#GAUNTLET_SLACK_WEBHOOK=https://hooks.slack.com/services/...
#GAUNTLET_TEAMS_WEBHOOK=https://outlook.office.com/webhook/...

# Evidence attachments (P3): per-file cap (keep under GAUNTLET_MAX_REQUEST_BYTES, base64 adds a third) and per-exercise count
#GAUNTLET_MAX_EVIDENCE_BYTES=3145728
#GAUNTLET_MAX_EVIDENCE_PER_SESSION=50

# Licensing (L1) — see docs/LICENSING.md
#GAUNTLET_LICENSE_PUBKEY=          # vendor public key (base64url); empty = every token is invalid = Community
#GAUNTLET_LICENSE=GL1....          # or install via the Members page
